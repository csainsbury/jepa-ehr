{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clinical-jepa-pseudo-rendering-readiness-v0",
  "type": "object",
  "required": [
    "schema_version",
    "created_utc",
    "scenario_id",
    "aggregate_only",
    "retrieval_policy",
    "top_k",
    "queries_evaluated",
    "retrieved_topk_rows",
    "retrieval",
    "warnings"
  ],
  "properties": {
    "schema_version": {"type": "string", "enum": ["clinical-jepa-pseudo-rendering-readiness-v0"]},
    "created_utc": {"type": "string"},
    "scenario_id": {"type": "string"},
    "aggregate_only": {"type": "boolean", "const": true},
    "retrieval_policy": {"type": "string"},
    "top_k": {"type": "integer", "minimum": 1},
    "max_candidates_per_group": {"type": "integer", "minimum": 0},
    "min_candidates_per_group": {"type": "integer", "minimum": 0},
    "query_rows": {"type": "integer", "minimum": 0},
    "target_rows": {"type": "integer", "minimum": 0},
    "exclude_true_target_from_analogues": {"type": "boolean"},
    "exclude_same_patient_analogues": {"type": "boolean"},
    "same_patient_exclusion_applied": {"type": "boolean"},
    "queries_evaluated": {"type": "integer", "minimum": 0},
    "retrieved_topk_rows": {"type": "integer", "minimum": 0},
    "skipped_no_target": {"type": "integer", "minimum": 0},
    "skipped_no_candidates": {"type": "integer", "minimum": 0},
    "candidate_count_summary": {"type": "object"},
    "retrieval": {"type": "object"},
    "spec_consistency_rate": {"type": ["number", "null"]},
    "negative_control_rate": {"type": ["number", "null"]},
    "matched_random_control": {"type": "object"},
    "retrieved_subject_diversity_ratio": {"type": "number", "minimum": 0},
    "retrieved_count_summaries": {"type": "object"},
    "groups": {"type": "object"},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "string"}
  }
}
