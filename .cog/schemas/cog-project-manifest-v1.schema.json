{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/csainsbury/cog-continuity-inbox/schemas/cog-project-manifest-v1.schema.json",
  "title": "Cog project manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "transport", "allowed_refs", "documents", "limits"],
  "properties": {
    "schema_version": {"const": "cog-project-manifest-v1"},
    "project": {"type": "object", "additionalProperties": false, "required": ["slug", "repository"], "properties": {"slug": {"const": "jepa"}, "repository": {"const": "csainsbury/jepa-ehr"}}},
    "transport": {"type": "object", "additionalProperties": false, "required": ["repository"], "properties": {"repository": {"const": "csainsbury/cog-continuity-inbox"}}},
    "allowed_refs": {"type": "array", "const": ["refs/heads/cog/jepa-continuity-pilot"]},
    "documents": {
      "type": "array", "minItems": 1, "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "label", "role", "classification"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 300},
          "label": {"type": "string", "minLength": 1, "maxLength": 100},
          "role": {"enum": ["overview", "status", "blueprint", "result", "decision", "resume", "evidence"]},
          "classification": {"const": "safe_distilled"}
        }
      }
    },
    "limits": {"type": "object", "additionalProperties": false, "required": ["max_file_bytes", "max_total_bytes"], "properties": {"max_file_bytes": {"type": "integer", "minimum": 1, "maximum": 262144}, "max_total_bytes": {"type": "integer", "minimum": 1, "maximum": 524288}}}
  }
}
